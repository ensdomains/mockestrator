{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "ox/tempo": ["./node_modules/ox/_types/tempo/index.d.ts"],
      "ox/tempo/*": ["./node_modules/ox/_types/tempo/*.d.ts"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__"
  ]
}